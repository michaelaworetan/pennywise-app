{
  "expo": {
    "name": "PennyWise",
    "slug": "pennywise-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B5E4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pennywise.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.pennywise.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B5E4F"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "pennywise",
    "extra": {
      "environment": "dev"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
